{
  "name": "@ipdm/client",
  "version": "0.0.1",
  "repository": "https://github.com/vercel/examples.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "TIMING=1 eslint \"**/*.{ts,js}\" --fix",
    "clean": "rm -rf ./dist && rm -rf .turbo",
    "test": "npm run test:src && npm run test:examples",
    "test:src": "tap --disable-coverage --node-arg=--import=tsx/esm src/**/*.test.ts src/*.test.ts",
    "test:examples": "cd examples/browser-to-browser && npm i && npm run test"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*",
        "src/*/index"
      ]
    }
  },
  "publishConfig": {
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@helia/interface": "^6.1.1",
    "@libp2p/interface": "^3.1.0",
    "@types/jest": "^30.0.0",
    "@zaach/rollup-plugin-node-polyfills": "^0.2.2",
    "eslint": "^10.0.0",
    "react": "^18.3.1",
    "interface-blockstore": "^6.0.1",
    "interface-datastore": "^9.0.2",
    "tap": "^21.5.1",
    "tape": "^5.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/unixfs": "^7.0.4",
    "@libp2p/bootstrap": "^12.0.11",
    "@libp2p/mplex": "^12.0.11",
    "@libp2p/tcp": "^11.0.10",
    "@libp2p/webrtc": "^6.0.11",
    "@libp2p/websockets": "^10.1.3",
    "@multiformats/multiaddr": "^13.0.1",
    "@stablelib/base64": "^2.0.1",
    "@stablelib/ed25519": "^2.0.2",
    "blockstore-core": "^6.1.2",
    "datastore-core": "^11.0.2",
    "helia": "^6.0.20",
    "hpke-js": "^1.6.5",
    "it-all": "^3.0.9",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.3",
    "jose": "^6.1.3",
    "libp2p": "^3.1.3",
    "multiformats": "^13.4.2",
    "uint8arrays": "^5.1.0"
  },
  "tap": {
    "plugin": [
      "!@tapjs/typescript"
    ],
    "exclude": [
      "src/session.test.ts"
    ]
  }
}
