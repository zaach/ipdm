{
  "name": "ipdm",
  "version": "1.0.0",
  "description": "p2p direct messaging",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview --port 8000",
    "build": "tsc --noEmit && vite build",
    "relay": "relay",
    "lint": "eslint --ext .ts,tsx --ignore-path .gitignore ."
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "tsc --noEmit",
    "*": "prettier -w -u"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@ipdm/client": "*",
    "@libp2p/mplex": "^12.0.11",
    "@libp2p/tcp": "11.0.10",
    "@libp2p/webrtc": "^6.0.11",
    "@libp2p/websockets": "^10.1.3",
    "@multiformats/multiaddr": "^13.0.1",
    "@preact/signals": "^2.8.1",
    "@prefresh/vite": "^2.4.11",
    "autoprefixer": "^10.4.24",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.3",
    "libp2p": "^3.1.3",
    "postcss": "^8.5.6",
    "preact": "^10.28.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.18",
    "uint8arrays": "^5.1.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@import-meta-env/typescript": "^0.4.1",
    "@import-meta-env/unplugin": "^0.6.3",
    "@preact/preset-vite": "^2.10.3",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@zaach/rollup-plugin-node-polyfills": "^0.2.2",
    "daisyui": "^5.5.18",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.0",
    "eslint-config-preact": "^2.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "test-ipfs-example": "^1.3.3",
    "typescript": "^5.9.3"
  }
}
